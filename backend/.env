# ========================================
# grainAdminPro Backend Environment Configuration
# ========================================
# Copy this file to .env and customize for your environment
# Development values are provided by default

# ========================================
# Application Settings
# ========================================
APP_NAME=grainAdminPro
APP_ENV=development  # development | staging | production
DEBUG=True  # Set to False in production
API_HOST=0.0.0.0
API_PORT=8000

# ========================================
# Database Configuration (PostgreSQL)
# ========================================
# Option A: Use PostgreSQL default superuser (simple for development)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grainadmin_dev

# Option B: Create dedicated user (RECOMMENDED)
# Run these commands first:
#   sudo -u postgres psql
#   CREATE USER grainadmin_user WITH PASSWORD 'dev_password_123';
#   CREATE DATABASE grainadmin_dev OWNER grainadmin_user;
#   GRANT ALL PRIVILEGES ON DATABASE grainadmin_dev TO grainadmin_user;
#   \q
DATABASE_URL=postgresql://padmin:Qwe!1234@localhost:5432/grainadmin_dev

# Database pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ========================================
# Redis Configuration
# ========================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
# Leave empty for local development, set in production

# ========================================
# Celery Configuration (Async Tasks)
# ========================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ========================================
# JWT Authentication
# ========================================
# Development: Use simple secret (HS256)
JWT_SECRET_KEY=dev-secret-key-change-in-production-use-at-least-32-chars
JWT_ALGORITHM=HS256

# Production: Use RS256 with key files
# JWT_ALGORITHM=RS256
# JWT_PRIVATE_KEY_PATH=/path/to/private_key.pem
# JWT_PUBLIC_KEY_PATH=/path/to/public_key.pem

# Token expiration
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================================
# File Upload Configuration
# ========================================
# Development: Local directory
UPLOAD_DIR=./uploads

# Production: Absolute path
# UPLOAD_DIR=/var/data/grainadmin/uploads

# File size limits (in MB)
MAX_FILE_SIZE_MB=10

# Allowed file types (comma-separated MIME types)
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# ========================================
# CORS Configuration
# ========================================
# Development: Allow local frontends
CORS_ORIGINS=http://localhost:8001,http://localhost:8002

# Production: Replace with actual domains
# CORS_ORIGINS=https://admin.grainadmin.com,https://merchant.grainadmin.com

CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# ========================================
# Logging Configuration
# ========================================
LOG_LEVEL=DEBUG  # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json  # json | text

# Log file paths (optional, stdout if not set)
# LOG_FILE=/var/log/grainadmin/api.log
# LOG_MAX_BYTES=10485760  # 10MB
# LOG_BACKUP_COUNT=5

# ========================================
# Security Settings
# ========================================
# Password hashing (bcrypt rounds)
BCRYPT_ROUNDS=12

# ========================================
# Email Configuration (Future Feature)
# ========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@grainadmin.com

# ========================================
# Frontend URLs (for redirects and notifications)
# ========================================
ADMIN_FRONTEND_URL=http://localhost:8001
MERCHANT_FRONTEND_URL=http://localhost:8002

# ========================================
# Performance & Monitoring
# ========================================
# Enable slow query logging (queries > threshold)
SLOW_QUERY_THRESHOLD_MS=100

# Cache TTL (seconds)
CACHE_DEFAULT_TTL=3600  # 1 hour
CACHE_MERCHANT_INFO_TTL=3600  # 1 hour
CACHE_AUDITOR_PERMISSIONS_TTL=900  # 15 minutes

# ========================================
# Rate Limiting (Future Feature)
# ========================================
# RATE_LIMIT_PER_MINUTE=60
# RATE_LIMIT_PER_HOUR=1000

# ========================================
# Sentry Error Tracking (Production Only)
# ========================================
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ========================================
# IMPORTANT SECURITY NOTES
# ========================================
# 1. NEVER commit .env file to git (already in .gitignore)
# 2. Use strong passwords in production (min 16 chars, mixed case, numbers, symbols)
# 3. Regenerate JWT_SECRET_KEY for each environment
# 4. Use RS256 JWT algorithm in production with separate key files
# 5. Enable HTTPS in production (configure in Nginx)
# 6. Use environment-specific databases (never use dev DB in production)